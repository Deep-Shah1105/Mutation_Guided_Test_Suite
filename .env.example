# Required for full LLM-driven agent behavior. Without it, deterministic fallbacks are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_TIMEOUT_SECONDS=60

# Comma-separated frontend origins. Add the deployed frontend URL before deployment.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000

TRACE_PATH=trace.jsonl
MAX_AGENT_ROUNDS=3
AGENT_TIMEOUT_SECONDS=15
MUTATION_TIMEOUT_SECONDS=45
